{% extends 'layouts/page.njk' %}

{% from "govuk/components/summary-list/macro.njk" import govukSummaryList %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "govuk/components/details/macro.njk" import govukDetails %}
{% from "govuk/components/tag/macro.njk" import govukTag %}

{% block content %}
  {{ appHeading({
    text: heading,
    caption: "CPH: " + holding.cph
  }) }}

  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">

      {% if holding.description %}
        <p class="govuk-body-l">{{ holding.description }}</p>
      {% endif %}

      <h2 class="govuk-heading-m">Core Information</h2>
      
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "CPH Number"
            },
            value: {
              html: '<span class="govuk-!-font-weight-bold">' + holding.cph + '</span>'
            }
          },
          {
            key: {
              text: "Farm Name"
            },
            value: {
              text: holding.name
            }
          },
          {
            key: {
              text: "Description"
            },
            value: {
              text: holding.description if holding.description else "Not provided"
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Contact Information</h2>
      
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Telephone"
            },
            value: {
              html: '<a href="tel:' + contacts.telephone + '" class="govuk-link" aria-label="Call ' + contacts.telephone + '">' + contacts.telephone + '</a>'
            }
          },
          {
            key: {
              text: "Email"
            },
            value: {
              html: '<a href="mailto:' + contacts.email + '" class="govuk-link" aria-label="Send email to ' + contacts.email + '">' + contacts.email + '</a>'
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Address</h2>
      
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Full Address"
            },
            value: {
              html: holding.address.street + "<br>" +
                   (holding.address.locality + "<br>" if holding.address.locality else "") +
                   holding.address.town + "<br>" +
                   holding.address.county + "<br>" +
                   '<span class="govuk-!-font-weight-bold">' + holding.address.postcode + '</span>'
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Geolocation</h2>
      
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "OS Grid Reference"
            },
            value: {
              html: '<span class="govuk-!-font-family-monospace govuk-!-font-weight-bold">' + holding.geolocation.mapRef + '</span>'
            }
          },
          {
            key: {
              text: "Easting"
            },
            value: {
              html: '<span class="govuk-!-font-family-monospace">' + holding.geolocation.easting + '</span>'
            }
          },
          {
            key: {
              text: "Northing"
            },
            value: {
              html: '<span class="govuk-!-font-family-monospace">' + holding.geolocation.northing + '</span>'
            }
          },
          {
            key: {
              text: "Coordinates"
            },
            value: {
              html: '<span class="govuk-!-font-family-monospace">' + holding.geolocation.easting + ', ' + holding.geolocation.northing + '</span>'
            }
          }
        ]
      }) }}

      <h2 class="govuk-heading-m">Record Information</h2>
      
      {{ govukSummaryList({
        rows: [
          {
            key: {
              text: "Created"
            },
            value: {
              html: formatDate(holding.metadata.created) + "<br><span class=\"govuk-hint\">by " + holding.metadata.createdBy + "</span>"
            }
          },
          {
            key: {
              text: "Last Updated"
            },
            value: {
              html: formatDate(holding.metadata.lastUpdated) + "<br><span class=\"govuk-hint\">by " + holding.metadata.lastUpdatedBy + "</span>"
            }
          }
        ]
      }) }}

      <div class="govuk-button-group">
        {{ govukButton({
          text: "Edit Holding",
          href: "/holdings/" + holding.cph | urlencode + "/edit",
          classes: "govuk-button--secondary"
        }) }}
        
        {{ govukButton({
          text: "Create New Holding",
          href: "/holdings/create",
          classes: "govuk-button--secondary"
        }) }}
        
        {{ govukButton({
          text: "Holdings Management",
          href: "/holdings",
          classes: "govuk-button--secondary"
        }) }}
      </div>

    </div>

    <div class="govuk-grid-column-one-third">
      <aside class="app-related-items" role="complementary">
        <h2 class="govuk-heading-m" id="subsection-title">
          Related actions
        </h2>
        <nav role="navigation" aria-labelledby="subsection-title">
          <ul class="govuk-list govuk-!-font-size-16">
            <li>
              <a class="govuk-link" href="/incidents/create?cph={{ holding.cph | urlencode }}">
                Create TB incident
              </a>
            </li>
            <li>
              <a class="govuk-link" href="/movements/search?cph={{ holding.cph | urlencode }}">
                View animal movements
              </a>
            </li>
            <li>
              <a class="govuk-link" href="/tests/history?cph={{ holding.cph | urlencode }}">
                View test history
              </a>
            </li>
            <li>
              <a class="govuk-link" href="/holdings/{{ holding.cph | urlencode }}/print">
                Print holding details
              </a>
            </li>
          </ul>
        </nav>

        {{ govukTag({
          text: "Active",
          classes: "govuk-tag--green"
        }) }}
        
        <p class="govuk-hint govuk-!-margin-top-2">
          This holding is currently active and available for incident management.
        </p>
      </aside>
    </div>
  </div>

{% endblock %}
